APP_ENV=development
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
POSTGRES_DB=osa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-secret
OSA_APP_PASSWORD=replace-with-a-local-secret
OSA_MIGRATOR_PASSWORD=replace-with-a-local-secret
OSA_WORKER_PASSWORD=replace-with-a-local-secret
REDIS_PASSWORD=replace-with-a-local-secret
DATABASE_URL=postgresql+asyncpg://osa_app:replace-with-a-local-secret@localhost:5432/osa
DATABASE_READ_URL=
DB_POOL_MIN=5
DB_POOL_MAX=20
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://osa_migrator:replace-with-a-local-secret@localhost:5432/osa
WORKER_DATABASE_URL=postgresql+asyncpg://osa_worker:replace-with-a-local-secret@localhost:5432/osa
SIMULATE_KIOSK_CODE=
SIMULATE_KIOSK_TOKEN=
REDIS_STATE_URL=redis://:replace-with-a-local-secret@localhost:6379/0
REDIS_CACHE_URL=redis://:replace-with-a-local-secret@localhost:6379/1
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_KID=k1
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_HOURS=8
KIOSK_TOKEN_HOURS=12
PATIENT_SESSION_HOURS=2
MAX_REQUEST_BODY_BYTES=1048576
# Back these keys up outside the repository and keep them stable across restarts.
# Losing APP_DATA_KEY makes encrypted patient data unreadable; changing APP_HMAC_KEY
# breaks lookups that depend on hashes created with its previous value.
APP_DATA_KEY=replace-with-base64-encoded-32-byte-key
APP_HMAC_KEY=replace-with-base64-encoded-32-byte-key
CURSOR_HMAC_KEY=replace-with-base64-encoded-32-byte-key
DEMO_ADMIN_EMAIL=admin@demo.opdsathi.test
DEMO_ADMIN_PASSWORD=replace-with-a-12-character-demo-password
DEMO_STAFF_PASSWORD=replace-with-a-12-character-demo-password
PROVIDER_MODE=mock
STT_PROVIDER=mock
STT_MODEL=saaras:v3-realtime
SARVAM_API_KEY=example-not-a-real-key
STORE_AUDIO=false
LLM_PROVIDER=mock
LLM_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=example-not-a-real-key
# Process-wide kill switch; each hospital must also opt in via its admin settings.
LLM_ENABLED=true
LLM_MAX_CALLS_PER_SESSION=30
LLM_MAX_OUTPUT_TOKENS=1024
TTS_PROVIDER=mock
TTS_MODEL=
STORE_AUDIO=false
READBACK_LLM=false
MAX_QUESTIONS=12
URGENT_BONUS_MIN=360
PRIORITY_BONUS_MIN=45
VULNERABLE_BONUS_MIN=15
DEFAULT_CONSULT_MIN=4.0
RETENTION_DAYS=30
ANONYMISE_DAYS=90
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=opd-saathi
S3_ACCESS_KEY=
S3_SECRET_KEY=
SMS_PROVIDER=console
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
