APP_ENV=development
WEB_ORIGIN=http://localhost:5173
# Address patients' phones use to open the token QR link, e.g. http://192.168.1.20:5173.
# Leave empty: start-demo.ps1 fills in this PC's Wi-Fi address on every run.
PUBLIC_WEB_URL=
# Optional same-origin public asset path for a clinic logo, e.g. /hospital-logo.svg
VITE_HOSPITAL_LOGO_URL=
LOG_LEVEL=INFO
METRICS_ENABLED=false
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-secret
# API worker processes (gunicorn).
WEB_CONCURRENCY=2
POSTGRES_DB=osa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-secret
OSA_APP_PASSWORD=replace-with-a-local-secret
OSA_MIGRATOR_PASSWORD=replace-with-a-local-secret
OSA_WORKER_PASSWORD=replace-with-a-local-secret
REDIS_PASSWORD=replace-with-a-local-secret
DATABASE_URL=postgresql+asyncpg://osa_app:replace-with-a-local-secret@127.0.0.1:5432/osa
# Optional read-only replica used for report exports; empty means the primary.
DATABASE_READ_URL=
# Database connections per API process: kept open / opened at peak (docs/SCALING.md).
DB_POOL_MIN=5
DB_POOL_MAX=20
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://osa_migrator:replace-with-a-local-secret@127.0.0.1:5432/osa
WORKER_DATABASE_URL=postgresql+asyncpg://osa_worker:replace-with-a-local-secret@127.0.0.1:5432/osa
SIMULATE_KIOSK_CODE=
SIMULATE_KIOSK_TOKEN=
REDIS_STATE_URL=redis://:replace-with-a-local-secret@127.0.0.1:6379/0
REDIS_CACHE_MAXMEMORY=256mb
REDIS_CACHE_URL=redis://:replace-with-a-local-secret@127.0.0.1:6380/0
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_KID=k1
# During a signing-key rotation only (docs/runbooks/key-rotation.md): the previous key, still
# accepted until its tokens expire. Leave empty otherwise.
JWT_PREVIOUS_SECRET=
JWT_PREVIOUS_KID=
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_HOURS=8
KIOSK_TOKEN_HOURS=12
PATIENT_SESSION_HOURS=2
MAX_REQUEST_BODY_BYTES=1048576
# Back these keys up outside the repository and keep them stable across restarts.
# Losing APP_DATA_KEY makes encrypted patient data unreadable; changing APP_HMAC_KEY
# breaks lookups that depend on hashes created with its previous value.
APP_DATA_KEY=replace-with-base64-encoded-32-byte-key
APP_HMAC_KEY=replace-with-base64-encoded-32-byte-key
CURSOR_HMAC_KEY=replace-with-base64-encoded-32-byte-key
# Opens only the phone numbers patients opted in to queue messages for (today only). It is
# the worker's single key: the worker never holds APP_DATA_KEY. Required when
# NOTIFICATION_PROVIDER is twilio or whatsapp; must differ from APP_DATA_KEY. The setup
# scripts generate it; empty is fine while messages only go to the console.
NOTIFY_KEY=
# Data-key rotation (docs/runbooks/key-rotation.md): the current key's id, and the earlier keys
# still needed to read old records as "id:base64,id:base64". Defaults: id 1, none.
APP_DATA_KEY_ID=1
APP_DATA_PREVIOUS_KEYS=
# Roles that must use two-step sign-in (comma-separated; production always includes admin).
# "none" requires it of no one: the local demo (start-demo.ps1) uses that.
MFA_REQUIRED_ROLES=admin
# Before live patients (docs/GO_LIVE_CHECKLIST.md): true makes the API refuse to start while any
# clinical content is still a draft awaiting sign-off (docs/CLINICIAN_REVIEW.md).
CLINICAL_CONTENT_APPROVAL_REQUIRED=false
DEMO_ADMIN_EMAIL=admin@demo.opdsathi.test
DEMO_ADMIN_PASSWORD=replace-with-a-12-character-demo-password
DEMO_STAFF_PASSWORD=replace-with-a-12-character-demo-password
# ---- AI and voice -------------------------------------------------------------
# Paste your keys here. With the *_PROVIDER settings on "auto" the app uses:
#   GEMINI_API_KEY  -> AI case summary + English translation for the doctor,
#                      smarter question order, prescription photo reading,
#                      and (if no Sarvam key) speech-to-text and read-aloud.
#                      Free key: https://aistudio.google.com/apikey
#   SARVAM_API_KEY  -> best Hindi/Marathi speech-to-text and natural voices.
#                      Free credits: https://dashboard.sarvam.ai
# With no keys the kiosk still works: browser speech recognition (Chrome/Edge),
# browser read-aloud, tap-to-answer, and rules-only safety checks.
GEMINI_API_KEY=
SARVAM_API_KEY=
LLM_PROVIDER=auto
STT_PROVIDER=auto
TTS_PROVIDER=auto
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite
LLM_THINKING_LEVEL=minimal
# Let Gemini add up to 3 complaint-specific follow-up questions (bank questions are the fallback).
AI_FOLLOWUP_QUESTIONS=true
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
TTS_MODEL=bulbul:v3
# Optional Sarvam voice name, e.g. shubh, priya, kavya (blank = provider default).
TTS_VOICE=
STT_MODEL=saaras:v3-realtime
# Global AI kill switch. A hospital can also switch AI off in Settings.
LLM_ENABLED=true
LLM_MAX_CALLS_PER_SESSION=30
LLM_MAX_OUTPUT_TOKENS=1024
# "demo-safe" replays canned fixtures with no network calls (offline rehearsals only).
PROVIDER_MODE=standard
DEMO_STORY=hindi-fever
STORE_AUDIO=false
URGENT_BONUS_MIN=360
PRIORITY_BONUS_MIN=45
VULNERABLE_BONUS_MIN=15
DEFAULT_CONSULT_MIN=4.0
RETENTION_DAYS=30
ANONYMISE_DAYS=90
NOTIFICATION_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
